APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docuask
POSTGRES_USER=docuask
POSTGRES_PASSWORD=replace-with-a-unique-local-password

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docuask_e5_small_v1
PRELOAD_EMBEDDINGS=true
PDFIUM_FALLBACK=true
OCR_ENABLED=false

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
AUTH_RATE_LIMIT=60
API_RATE_LIMIT=180

STORAGE_DIR=storage
MAX_UPLOAD_BYTES=10485760
STALE_PROCESSING_MINUTES=30

LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=add-a-key-only-if-using-openai
RETRIEVAL_MODE=dense
RERANK_ENABLED=false
RERANK_CANDIDATES=20
QA_MIN_SCORE=0.45
QA_MAX_ANSWER_CHARS=10000

# Public DNS hostname for compose.production.yml
DOCUASK_DOMAIN=localhost
