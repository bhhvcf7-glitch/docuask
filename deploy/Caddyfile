{$DOCUASK_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        -Server
    }
    @api path /auth/* /documents /documents/* /qa/* /search /conversations /conversations/* /health /ready
    handle @api {
        request_body {
            max_size 105MB
        }
        reverse_proxy api:8000 {
            header_up X-Forwarded-For {http.request.remote.host}
            flush_interval -1
        }
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
